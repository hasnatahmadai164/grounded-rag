# Logging
LOG_LEVEL=INFO
# JSON lines for production, false for readable console output while developing.
LOG_JSON=false
# When true, raw questions and answers are written to the logs. Keep false for private data.
LOG_CONTENT=false

# PostgreSQL (source of truth for text, chunks, access control and API keys)
DATABASE_URL=postgresql+asyncpg://grounded_rag:grounded_rag@localhost:5432/grounded_rag
DATABASE_POOL_SIZE=5

# Corpus used when a request or CLI command does not name one. One corpus maps to one Pinecone namespace.
DEFAULT_CORPUS=default

# OpenAI (chat and embeddings). Model IDs and prices are configuration, not code:
# check them against the provider's current documentation before relying on cost figures.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must match the Pinecone index dimension.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=96
# Timeout for each provider call and how many times a failed call is retried.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0
# Set to false for models that only accept their default temperature.
LLM_SEND_TEMPERATURE=true
LLM_MAX_OUTPUT_TOKENS=1024
# USD per million tokens, used for the per-request usage report and evaluation cost figures.
CHAT_INPUT_USD_PER_MTOK=0.15
CHAT_OUTPUT_USD_PER_MTOK=0.60
EMBEDDING_USD_PER_MTOK=0.02

# Pinecone (serverless index, cosine metric). The index dimension must equal EMBEDDING_DIMENSIONS.
# Cloud and region are used by `grounded-rag index create`; check which regions your plan allows.
PINECONE_API_KEY=pcsk-your-key-here
PINECONE_INDEX_NAME=grounded-rag
# Optional: data-plane host of the index. When blank it is looked up by name at first use.
PINECONE_INDEX_HOST=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Pinecone API version header sent with every request.
PINECONE_API_VERSION=2025-01
PINECONE_TIMEOUT_SECONDS=15
PINECONE_MAX_RETRIES=3

# Chunking, in characters. Paragraphs are packed up to the target; a single paragraph above the
# maximum is split at sentence boundaries with the given overlap.
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=1800
CHUNK_MIN_CHARS=200
CHUNK_OVERLAP_CHARS=150

# Retrieval. DEFAULT_TOP_K chunks go to the model; a request may ask for up to MAX_TOP_K.
DEFAULT_TOP_K=6
MAX_TOP_K=20
# Candidates taken from each retriever, the reciprocal rank fusion constant, and how many fused
# candidates continue to the access check and reranking.
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_LEXICAL_TOP_K=30
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATES=20

# Per-request ceilings. A request that reaches either one stops calling the model and abstains.
# A call that is already running is not interrupted, so a request can overshoot by one call.
REQUEST_TOKEN_BUDGET=60000
REQUEST_COST_BUDGET_USD=0.05

# Evaluation runs store every model and embedding response here, keyed by a hash of the request,
# so repeating a run costs nothing and gives the same answers.
EVAL_CACHE_DIR=.cache/llm

# Answer loop. Reranking adds one model call per question. Rewrites retry retrieval with a new
# query when the retrieved passages are judged insufficient; repairs re-ask for citations that
# fail verification.
RERANK_ENABLED=true
AGENT_MAX_REWRITES=2
AGENT_MAX_REPAIRS=1
AGENT_MAX_CONTEXT_CHUNKS=10

# Upper bound on the time one /v1/query request may take, retries and rewrites included.
REQUEST_TIMEOUT_SECONDS=60

# Evaluation. The judge grades answers; leave JUDGE_MODEL blank to use CHAT_MODEL. A different
# model is a better judge, because a model tends to rate its own phrasing favourably.
JUDGE_MODEL=
# Evaluations ingest the CUAD subset into this corpus (a separate Pinecone namespace).
EVAL_CORPUS=eval-cuad

# Requests with a larger body are rejected before they are parsed.
MAX_REQUEST_BYTES=65536
